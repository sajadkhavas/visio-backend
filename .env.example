# Local development only. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=visio
POSTGRES_USER=visio
POSTGRES_PASSWORD=visio
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Payments are fail-closed by default.
PAYMENTS_ENABLED=0
PAYMENT_PROVIDER=disabled
PAYMENT_CALLBACK_URL=
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10
ZARINPAL_MERCHANT_ID=
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_SANDBOX=1

# Notifications are fail-closed by default. Use a production-capable backend only in production.
NOTIFICATIONS_ENABLED=0
NOTIFICATIONS_AUTO_DISPATCH=1
NOTIFICATION_CHANNEL=email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
